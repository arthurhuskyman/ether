{
  "name": "ether-sdk",
  "version": "0.1.0",
  "description": "SDK для ботов и мостов The Messenger (Ether): сквозное шифрование и сигнальный протокол v1 на Node без зависимостей",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "exports": { ".": { "import": "./index.mjs", "require": "./index.cjs" } },
  "files": ["index.cjs", "index.mjs", "core.cjs", "js", "README.md", "examples"],
  "engines": { "node": ">=22" },
  "scripts": {
    "prepack": "node -e \"const fs=require('fs');fs.mkdirSync('js/vendor',{recursive:true});for(const f of ['ratchet.js','groupkeys.js','channels.js','crypto-helper.js','vendor/ml-kem768.js'])fs.copyFileSync('../js/'+f,'js/'+f)\"",
    "test": "node --test ../tests/sdk.test.js"
  }
}
